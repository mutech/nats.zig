.{
    .name = .nats,
    .version = "0.1.0",
    // Changing fingerprint has security and trust implications.
    .fingerprint = 0x31f7624fb15addf7,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Test/example-only. The library takes `io: std.Io` and depends on
        // nothing; this backend lets the suite and examples run on zio's evented
        // Io. `lazy` so consumers of the `nats` module never fetch it. Release
        // v0.20.1; kept at the latest zio release each upstream sync.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#c0a6b5877c9bbc71d2d2c0b3374ce7fa61a4ec12",
            .hash = "zio-0.20.1-xHbVVI0wLwDgE2dXWDCWH0UfCQYEhnBYHs1Td12oAGeR",
            .lazy = true,
        },
    },
    .paths = .{
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "build.zig",
        "build.zig.zon",
        "doc",
        "logo",
        "src",
    },
}
